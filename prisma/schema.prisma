generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// À qui appartient le wish : correspond à l'onglet de la page d'accueil
enum Owner {
  ROJO
  SONNY
}

// Anciens profils R / S, remplacés par Owner
enum Person {
  R
  S
}

model Wish {
  id        String   @id @default(cuid())
  title     String
  price     String?
  comment   String?
  photoUrl  String?
  links     String[]
  // La valeur par défaut garde compatible la version déjà déployée, qui ne renseigne pas owner
  owner     Owner    @default(ROJO)
  // Ancien auteur (profils R / S, abandonnés) : plus renseigné par l'app
  addedBy   Person?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tentatives de connexion échouées, pour limiter les essais de mot de passe
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}
